# Database (checkpointer)
LANGGRAPH_PG_URI=postgresql://nous-ai:password@postgres:5432/nous_ai_db

# MinIO (optional)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=nous-ai
MINIO_SECRET_KEY=password
MINIO_BUCKET=nous-ai-bucket

# Service
AGENT_PORT=2024

# Config paths
DEER_FLOW_CONFIG_PATH=/app/config.yaml
DEER_FLOW_EXTENSIONS_CONFIG_PATH=/app/extensions_config.json

# API Keys
OPENAI_API_KEY=your-openai-api-key
TAVILY_API_KEY=your-tavily-api-key
JINA_API_KEY=your-jina-api-key
