# Nous Agent environment template. Copy to .env and set only what you use.
# Never commit real credentials.

# At least one key must match a model enabled in agent-go/config.example.yaml.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# Optional OpenAI-compatible model gateway.
TUYOO_BASE_URL=
TUYOO_API_KEY=

# Optional tools.
TAVILY_API_KEY=
JINA_API_KEY=

# Required PostgreSQL persistence for agentd. Apply schema migrations before startup.
# Redis is optional and used only when HTTP rate limiting is enabled.
# Compose reaches host services through host.docker.internal.
# DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/DBNAME?sslmode=disable
# REDIS_URL=redis://host.docker.internal:6379/0
DATABASE_URL=
REDIS_URL=

# Legacy Python services only.
# LANGGRAPH_PG_URI=postgresql://USER:PASSWORD@host.docker.internal:5432/DBNAME
LANGGRAPH_PG_URI=

# Legacy object storage only.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# Optional host-port overrides.
AGENT_PORT=7776
GATEWAY_PORT=7777
LEGACY_AGENT_PORT=17776
LEGACY_GATEWAY_PORT=17777
CORS_ORIGINS=http://localhost:7775,http://127.0.0.1:7775

# Shared Go platform logging and optional distributed HTTP rate limiting.
LOG_LEVEL=info
HTTP_RATE_LIMIT_ENABLED=false
HTTP_RATE_LIMIT_REQUESTS=60
HTTP_RATE_LIMIT_WINDOW=1m

# 可选：原生插件启停设置；为空时使用扩展配置同目录的 plugins.json
NOUS_PLUGIN_STATE_PATH=
