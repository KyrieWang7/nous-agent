# ============================================================================
# Nous Agent — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.

# --- LLM API Keys ---
OPENAI_API_KEY=sk-your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# MINIMAX_API_KEY=your-minimax-api-key

# Optional OpenAI-compatible gateway. Reference these variables from
# agent-go/config.example.yaml when routing all models through one gateway.
# TUYOO_BASE_URL=https://your-tuyoo-openai-compatible-gateway/v1
# TUYOO_API_KEY=your-tuyoo-api-key

# --- Web Search (optional) ---
# TAVILY_API_KEY=your-tavily-api-key
# JINA_API_KEY=your-jina-api-key

# --- PostgreSQL ---
LANGGRAPH_PG_URI=postgresql://nous-ai:password@localhost:5432/nous_ai_db

# --- MinIO (optional, for file storage) ---
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=nous-ai
# MINIO_SECRET_KEY=password
# MINIO_BUCKET=nous-ai-bucket

# --- Service Ports (defaults) ---
# AGENT_PORT=2024
# GATEWAY_PORT=8001
