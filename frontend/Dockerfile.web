FROM node:22-bookworm-slim
RUN corepack enable && corepack install -g pnpm@10.26.2

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . ./
ARG GATEWAY_BASE_URL=http://gateway-go:7777
ENV GATEWAY_BASE_URL=${GATEWAY_BASE_URL}
RUN pnpm build && mkdir -p .next/cache && chown -R node:node .next/cache

ENV NODE_ENV=production
USER node
EXPOSE 7775
CMD ["node", "node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0", "--port", "7775"]
