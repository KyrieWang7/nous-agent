FROM node:22-bookworm-slim AS build
RUN corepack enable && corepack install -g pnpm@10.26.2

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . ./
ARG NEXT_PUBLIC_NOUS_BASE_PATH
ENV NEXT_PUBLIC_NOUS_BASE_PATH=${NEXT_PUBLIC_NOUS_BASE_PATH}
ENV GATEWAY_BASE_URL=http://gateway-go:7777
ENV NOUS_NEXT_STANDALONE=1
RUN pnpm build

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
ENV NODE_ENV=production PORT=7775 HOSTNAME=0.0.0.0
USER node
EXPOSE 7775
CMD ["node", "server.js"]
